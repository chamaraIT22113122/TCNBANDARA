generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(uuid())
  title       String
  category    String   // e.g. WEB-APP, MOBILE APPLICATION
  description String
  techStack   String
  githubUrl   String?
  liveUrl     String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
